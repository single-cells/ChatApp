# Copy to deploy/.env (deploy/ is gitignored — do not commit secrets)
# docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env up -d

IMAGE_TAG=latest

POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=chat

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=chat-media

DATABASE_URL=postgresql://chat:change-me-postgres@postgres:5432/chat

JWT_SECRET=change-me-jwt-access
JWT_REFRESH_SECRET=change-me-jwt-refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_APP_SECRET=change-me-client-hmac
CLIENT_SIGN_SKIP=false

HOST=0.0.0.0
PORT=3000

REDIS_URL=redis://redis:6379

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=change-me-minio

CORS_ORIGIN=https://api.example.com

# Self-signed HTTPS (setup-ssl.sh bootstrap): set true when building APK via build-apk.ps1
# Use false after Let's Encrypt or other trusted certs are in place
ALLOW_INSECURE_SSL=false

# APK OTA（客户端 dart-define，默认关闭以省带宽）
# ENABLE_APP_UPDATE=false

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
